# PawFavoritees — environment variables (copy → .env.local, phir values bharo)

# ---------- Supabase (database) ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — client bundle mein kabhi import na ho
SUPABASE_SERVICE_ROLE_KEY=

# ---------- WooCommerce (Phase 6 — hosting ke baad) ----------
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ---------- Email (order confirmation) ----------
# Free key: https://resend.com/api-keys (200 emails/day free)
RESEND_API_KEY=
# Custom domain verify hone ke baad: PawFavoritees <orders@yourdomain.com>
EMAIL_FROM=
